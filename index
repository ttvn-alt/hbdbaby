<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday My Baby!</title>
    <style>
        :root {
            --primary-purple: #7B2CBF;
            --light-purple: #9D4EDD;
            --bg-purple: #F3E5F5;
            --accent-yellow: #FFD166;
            --bright-yellow: #FFB703;
            --dark-text: #240046;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-purple);
            color: var(--dark-text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
        }

        /* Confetti Canvas */
        #confetti-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10;
        }

        /* Permission Overlay */
        #permission-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(36, 0, 70, 0.95);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 100;
            transition: opacity 0.5s ease;
            color: white;
            text-align: center;
            padding: 20px;
        }

        .permission-card {
            background: white;
            color: var(--dark-text);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            max-width: 450px;
            width: 100%;
            border: 4px solid var(--accent-yellow);
        }

        .permission-card h2 {
            margin-bottom: 15px;
            color: var(--primary-purple);
        }

        .permission-card p {
            margin-bottom: 25px;
            line-height: 1.5;
            font-size: 1.1rem;
        }

        .btn {
            background-color: var(--primary-purple);
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(123, 44, 191, 0.4);
        }

        .btn:hover {
            background-color: var(--light-purple);
            transform: translateY(-2px);
        }

        .https-warning {
            margin-top: 15px;
            font-size: 0.85rem;
            color: #d90429;
            font-weight: bold;
        }

        /* Main Container */
        .container {
            max-width: 800px;
            width: 100%;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            z-index: 2;
        }

        /* Audio Visualizer / Instruction Box */
        .status-box {
            background: white;
            padding: 15px 25px;
            border-radius: 50px;
            box-shadow: 0 8px 20px rgba(123, 44, 191, 0.15);
            margin-bottom: 30px;
            font-weight: bold;
            border: 2px solid var(--light-purple);
            display: flex;
            align-items: center;
            gap: 15px;
            transition: all 0.3s ease;
        }

        .mic-indicator {
            width: 12px;
            height: 12px;
            background-color: #ff4d6d;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.9); opacity: 0.6; }
            50% { transform: scale(1.2); opacity: 1; }
            100% { transform: scale(0.9); opacity: 0.6; }
        }

        /* Cake & Shiba Styling */
        .cake-stage {
            position: relative;
            width: 320px;
            height: 380px;
            margin-bottom: 40px;
        }

        .shiba-cartoon {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 140px;
            z-index: 1;
        }

        .cake-cartoon {
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 280px;
            z-index: 2;
        }

        /* Candle & Flame */
        .candle-container {
            position: absolute;
            bottom: 190px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 3;
            width: 20px;
            height: 70px;
        }

        .candle-stick {
            width: 12px;
            height: 45px;
            background: linear-gradient(to right, #ffb703, #ffd166, #ffb703);
            margin: 0 auto;
            border-radius: 3px;
        }

        .flame {
            width: 16px;
            height: 26px;
            background: linear-gradient(to bottom, #ff007f, #ffb703, #ffd166);
            border-radius: 50% 50% 20% 20% / 60% 60% 40% 40%;
            margin: 0 auto;
            animation: flicker 0.1s infinite alternate;
            transform-origin: center bottom;
            box-shadow: 0 0 20px rgba(255, 183, 3, 0.8);
        }

        /* Dynamic Flame States controlled by JS */
        .flame.flicker-hard {
            animation: flicker-hard-anim 0.05s infinite alternate;
            transform: scale(0.8) skewX(10deg);
            opacity: 0.8;
        }

        .flame.blown-out {
            display: none;
        }

        /* Smoke effect after blowing out */
        .smoke {
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 8px;
            height: 20px;
            background: rgba(220, 220, 220, 0.7);
            border-radius: 50%;
            filter: blur(2px);
            opacity: 0;
            pointer-events: none;
        }

        .smoke.active {
            animation: smoke-rise 2s ease-out forwards;
        }

        @keyframes flicker {
            0% { transform: scale(1) rotate(-1deg); }
            100% { transform: scale(1.05) rotate(1deg); }
        }

        @keyframes flicker-hard-anim {
            0% { transform: scale(0.9, 0.6) rotate(-8deg) translateX(-2px); }
            100% { transform: scale(0.7, 0.5) rotate(8deg) translateX(2px); }
        }

        @keyframes smoke-rise {
            0% { top: -5px; opacity: 0.8; transform: translateX(-50%) scale(1); filter: blur(1px); }
            50% { top: -30px; opacity: 0.4; transform: translateX(-30%) scale(2); filter: blur(3px); }
            100% { top: -60px; opacity: 0; transform: translateX(-60%) scale(3); filter: blur(5px); }
        }

        /* Cats Container & Positioning around the cake */
        .cats-group {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            pointer-events: none;
            z-index: 4;
        }

        .cat {
            position: absolute;
            width: 85px;
            height: auto;
            opacity: 0;
            transform: scale(0.5);
            transition: all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        /* Reveal cats after blowing candle */
        .revealed .cat {
            opacity: 1;
            transform: scale(1);
        }

        /* Specific positions for the 5 cats around the cake */
        .cat-1 { bottom: 0px; left: -60px; transition-delay: 0.2s; }  /* Tuxedo */
        .cat-2 { bottom: 120px; left: -90px; transition-delay: 0.4s; } /* Light Cream */
        .cat-3 { bottom: 0px; right: -60px; transition-delay: 0.6s; } /* Brown Tabby */
        .cat-4 { bottom: 120px; right: -90px; transition-delay: 0.8s; } /* Orange Tabby */
        .cat-5 { top: -30px; right: -20px; transition-delay: 1s; }    /* Grey Tabby / Friend */

        /* Birthday Message Styling */
        .hbd-message {
            margin-top: 20px;
            opacity: 0;
            transform: translateY(30px);
            transition: all 1s ease;
        }

        .hbd-message.show {
            opacity: 1;
            transform: translateY(0);
        }

        .hbd-text {
            font-size: 3rem;
            font-weight: 900;
            color: var(--primary-purple);
            text-shadow: -3px -3px 0 var(--accent-yellow), 
                          3px -3px 0 var(--accent-yellow), 
                         -3px  3px 0 var(--accent-yellow), 
                          3px  3px 0 var(--accent-yellow),
                          0px  5px 10px rgba(0,0,0,0.15);
            letter-spacing: 2px;
            animation: bounce 2s infinite;
        }

        .sub-text {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--light-purple);
            margin-top: 10px;
            background: white;
            padding: 8px 20px;
            border-radius: 20px;
            display: inline-block;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        /* Responsive scaling */
        @media (max-width: 500px) {
            .cake-stage {
                transform: scale(0.85);
                margin-bottom: 10px;
            }
            .hbd-text {
                font-size: 2.2rem;
            }
        }
    </style>
</head>
